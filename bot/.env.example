# MEXC WEB token from browser — единственное, что нужно от MEXC.
# Официальные API-ключи НЕ нужны: и чтение баланса, и ордера идут через WEB-токен.
# Как получить: залогиньтесь на futures.mexc.com -> F12 -> Application ->
# Cookies -> https://futures.mexc.com -> значение cookie "u_id" (начинается с "WEB...")
MEXC_WEB_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
