# MEXC official API key (Account: View Account Details, Trade: View Order Details + Order Placing)
MEXC_API_KEY=
MEXC_API_SECRET=

# MEXC WEB token from browser (cookie "u_id", starts with "WEB...")
# Needed because the official futures order endpoint is under "maintenance".
# How to get it: futures.mexc.com -> F12 -> Application -> Cookies -> u_id
MEXC_WEB_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
